APP_ENV=development
DELIVERY_SECONDS=86400
DATABASE_PATH=data/luvbird.sqlite
PORT=4000
PUSH_ENABLED=false
# Set only on server if enhanced Expo push security is enabled.
# EXPO_ACCESS_TOKEN=
# Server-only Resend credentials; never put these in EXPO_PUBLIC_* variables.
# RESEND_API_KEY=
# EMAIL_FROM=DearBird <letters@your-verified-domain.example>
REQUIRE_EMAIL_VERIFICATION=false
# Set to 1 only behind one trusted proxy; API must not also be directly public.
TRUST_PROXY_HOPS=0

# Optional server-only operator access; generate with: openssl rand -hex 32
# OPERATIONS_TOKEN=
